# Configure these as environment variables/secrets on the HOSTED community service.
ALLOWED_ORIGINS=https://YOUR_USER.github.io
GITHUB_OWNER=YOUR_USER
GITHUB_REPO=english-with-clara
GITHUB_BRANCH=main
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# Private PEM key from the GitHub App. Never a VITE_ variable.
GITHUB_PRIVATE_KEY=
# Contents of private .student-auth/accounts.json, not student passwords.
STUDENT_ACCOUNTS_JSON={}
# Same private key as the admin Worker. Do not put it in the public repository.
STUDENT_LEVELS_KEY=
# Private repository on the same owner, initialized with a README.
STUDENT_FILES_REPO=
# HTTPS origin of the deployed admin Worker, used to verify teacher sessions.
TEACHER_ADMIN_API=
