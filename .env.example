# Dados públicos. Nunca coloque segredos em variáveis VITE_.
VITE_GITHUB_OWNER=SEU_USUARIO
VITE_GITHUB_REPO=english-with-clara
VITE_GITHUB_BRANCH=main
# Deixe vazio para usar o modo sem backend (edição pelo GitHub).
VITE_ADMIN_API=
# Para Pages de projeto: /english-with-clara/ ; para domínio próprio: /
VITE_BASE_PATH=/
# Public HTTPS origin of the community service. No secrets here.
# Development uses the real local community server automatically.
VITE_COMMUNITY_URL=
