{
  "name": "english-with-natalia-bellos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "admin:setup": "node scripts/setup-local-admin.mjs",
    "student:setup": "node scripts/setup-student.mjs",
    "community:start": "node server/start.mjs",
    "test:community": "node --test tests/community.node.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:check": "tsc --noEmit -p worker/tsconfig.json"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "styled-components": "^6.1.15",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.14.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.7.3",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.0.0"
  }
}
